{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "HeyBloopie",
  "version": "0.1.0",
  "identifier": "com.heybloopie.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HeyBloopie Overlay",
        "label": "main",
        "width": 640,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-grey.png",
      "tooltip": "HeyBloopie (Not Configured)",
      "iconAsTemplate": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/YOUR_GITHUB_USERNAME/heybloopie/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGN0REQzE5MUE0RDdDMTgKUldRWWZFMGFHZHg5cnlsMlJOTi9HYnlub1V2WnpReEVGWnJoY2RMZTg4Q1dWd3dZRklmYXpKOGEK"
    }
  }
}
